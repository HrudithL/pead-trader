__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.eggs/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
*.pem
*.key
credentials.json

# Jupyter
.ipynb_checkpoints/

# Data / research artifacts (large, regenerable, or external-drive-backed)
# NOTE: a plain `data/` ignore would also block the negations below (git
# won't descend into an already-ignored directory to re-check un-ignore
# rules), so this ignores contents one level at a time instead.
data/*
!data/metadata/
data/metadata/*
# ...except these small text/CSV provenance files -- not data, just an
# audit record of what was pulled from WRDS and when. The pull was later
# split into per-library scripts (see scripts/pull_wrds_*.py), so the one
# combined manifest became four per-library ones.
!data/metadata/wrds_pull_manifest_reference.csv
!data/metadata/wrds_pull_manifest_crsp.csv
!data/metadata/wrds_pull_manifest_compustat.csv
!data/metadata/wrds_pull_manifest_ibes.csv
!data/metadata/wrds_available_libraries.txt
mlruns/
experiments/
outputs/
*.parquet
*.duckdb

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
